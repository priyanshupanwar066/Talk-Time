# TalkTime environment variables
# Set NODE_ENV=production in the deployment environment, not during Vite builds.
PORT=3000
# Bind to all interfaces for LAN/mobile development access.
HOST=0.0.0.0
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority"
TEST_MONGODB_URI="mongodb://127.0.0.1:27017/talktime_test"
MONGODB_DB="talktime"
JWT_SECRET="<generate-a-long-random-secret>"
JWT_EXPIRES_IN="15m"
REDIS_URL="redis://localhost:6379"
UPLOAD_DIR="uploads"
CLIENT_URL="http://localhost:5173"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional integrations
RESEND_API_KEY=""
GEMINI_API_KEY=""
APP_URL=""
