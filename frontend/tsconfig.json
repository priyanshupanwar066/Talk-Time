{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "jsx": "react-jsx",

    "baseUrl": ".",
    "types": ["vite/client"],

    "paths": {
      "@/*": ["src/*"]
    },

    "noEmit": true
  },

  "include": ["src", "vite.config.ts"]
}